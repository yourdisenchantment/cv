---
import type { Cv } from "../../data/cv/schema";
import { type Locale } from "../../lib/format";
import Section from "./Section.astro";

interface Props {
    lang: Locale;
    skills: NonNullable<Cv["skills"]>;
}

const { lang, skills } = Astro.props;
---

<Section lang={lang} id="skills">
    <ul class="skill-list">
        {skills.map((s) => (
            <li>{s}</li>
        ))}
    </ul>
</Section>
