---
import type { Cv } from "../../data/cv/schema";
import { byPeriodDesc, type Locale } from "../../lib/format";
import EducationItem from "./EducationItem.astro";
import Section from "./Section.astro";

interface Props {
    lang: Locale;
    education: NonNullable<Cv["education"]>;
}

const { lang, education } = Astro.props;

const sorted = [...education].sort(byPeriodDesc);
---

<Section lang={lang} id="education">
    {sorted.map((edu) => (
        <EducationItem edu={edu} lang={lang} />
    ))}
</Section>
