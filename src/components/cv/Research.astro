---
import type { Cv } from "../../data/cv/schema";
import { type Locale, linkWithoutScheme } from "../../lib/format";
import Section from "./Section.astro";
import ExternalLink from "./ExternalLink.astro";

interface Props {
    lang: Locale;
    research: NonNullable<Cv["research"]>;
}

const { lang, research } = Astro.props;
---

<Section lang={lang} id="research">
    <p class="research-topic">{research.topic}</p>
    <p class="research-summary">{research.summary}</p>
    {research.path?.map((paragraph) => (
        <p class="research-summary">{paragraph}</p>
    ))}
    {research.links && research.links.length > 0 && (
        <ul class="entry-links">
            {research.links.map((link) => (
                <li>
                    <ExternalLink lang={lang} href={link.url}>
                        {link.label}
                    </ExternalLink>
                    {/* The address is print-only. On screen the label
                            is the better link text - short and scannable,
                            and the address is one click away. On paper
                            nothing is clickable, so a bare "Датасет" tells
                            the reader nothing about where it points. */}
                    <span class="link-address">
                        {linkWithoutScheme(link.url)}
                    </span>
                </li>
            ))}
        </ul>
    )}
</Section>
