---
import type { Cv } from "../../data/cv/schema";
import { type Locale } from "../../lib/format";
import { t } from "../../lib/i18n";
import PublicationItem from "./PublicationItem.astro";

interface Props {
    lang: Locale;
    publications: Cv["publications"];
}

const { lang, publications } = Astro.props;

// Newest on top: sort by year descending. Same-year entries keep their JSON
// order (Array.prototype.sort is stable), so JSON order does not matter.
const sorted = [...publications].sort((a, b) => b.year - a.year);
---

<section aria-labelledby="publications-heading" id="publications">
    <h2 class="section-heading" id="publications-heading">
        {t(lang, "publications")}
    </h2>
    <div class="section-body">
        {sorted.map((pub) => <PublicationItem pub={pub} lang={lang} />)}
    </div>
</section>
