---
import type { Cv } from "../../data/cv/schema";
import { type Locale } from "../../lib/format";
import { t } from "../../lib/i18n";
import Section from "./Section.astro";
import ExternalLink from "./ExternalLink.astro";

interface Props {
    lang: Locale;
    projects: NonNullable<Cv["projects"]>;
}

const { lang, projects } = Astro.props;
---

<Section lang={lang} id="projects">
    {projects.map((p) => (
        <article class="project-entry">
            <div class="entry-head">
                <h3 class="entry-title">{p.name}</h3>
                {/* "Code" repeats under every project, so the label form
                        is the right one here - see ExternalLink. */}
                <ExternalLink
                    lang={lang}
                    href={p.url}
                    label={`${t(lang, "sourceLink")}: ${p.name}`}
                >
                    {t(lang, "sourceLink")}
                </ExternalLink>
            </div>
            {p.description && <p class="entry-text">{p.description}</p>}
            {p.stack && (
                <ul class="skill-list">
                    {p.stack.map((s) => (
                        <li>{s}</li>
                    ))}
                </ul>
            )}
        </article>
    ))}
</Section>
