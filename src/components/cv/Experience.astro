---
import type { Cv } from "../../data/cv/schema";
import { byPeriodDesc, type Locale } from "../../lib/format";
import ExperienceItem from "./ExperienceItem.astro";
import Section from "./Section.astro";

interface Props {
    lang: Locale;
    experience: NonNullable<Cv["experience"]>;
}

const { lang, experience } = Astro.props;

const sorted = [...experience].sort(byPeriodDesc);
---

<Section lang={lang} id="experience">
    {sorted.map((job) => (
        <ExperienceItem job={job} lang={lang} />
    ))}
</Section>
