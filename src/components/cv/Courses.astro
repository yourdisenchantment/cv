---
import type { Cv } from "../../data/cv/schema";
import { byPeriodDesc, type Locale } from "../../lib/format";
import CourseItem from "./CourseItem.astro";
import Section from "./Section.astro";

interface Props {
    lang: Locale;
    courses: NonNullable<Cv["courses"]>;
}

const { lang, courses } = Astro.props;

const sorted = [...courses].sort(byPeriodDesc);
---

<Section lang={lang} id="courses">
    {sorted.map((course) => (
        <CourseItem course={course} lang={lang} />
    ))}
</Section>
