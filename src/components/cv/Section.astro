---
import { type Locale } from "../../lib/format";
import { t, type UiKey } from "../../lib/i18n";

// The shell every resume section shares: a labelled <section>, its heading,
// and the body wrapper. Exists because the parts are coupled in a way that
// breaks silently - the heading's id has to match the section's
// aria-labelledby, and nothing visual changes when they drift apart, so
// hand-writing the pair ten times was ten chances to lose the label.
//
// `id` doubles as the i18n key of the heading: every section's id and its
// dictionary key are the same word, so passing one is enough.
//
// About.astro deliberately does not use this. Its heading is hidden and
// preceded by the page's <h1> - it is the document identity rather than a
// section, and forcing it through here would mean a flag that only it sets.
interface Props {
    lang: Locale;
    id: UiKey;
    // Contacts wraps its body in <address>, the element for the author's
    // contact details; everything else is a plain <div>.
    bodyTag?: "div" | "address";
}

const { lang, id, bodyTag = "div" } = Astro.props;
const Body = bodyTag;
---

<section aria-labelledby={`${id}-heading`} id={id}>
    <h2 class="section-heading" id={`${id}-heading`}>
        {t(lang, id)}
    </h2>
    <Body class="section-body">
        <slot />
    </Body>
</section>
