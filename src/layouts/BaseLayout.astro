---
import "../styles/reset.css";
import "../styles/fonts.css";
import "../styles/variables.css";
import "../styles/styles.css";
import "../styles/cv-layout.css";
import "../styles/print.css";
import "../styles/debug.css";
import Dock from "../components/Dock.astro";
import { LOCALES, OG_IMAGE, canonicalUrl, ogImageUrl } from "../lib/canonical";

interface Props {
    lang: "ru" | "en";
    title: string;
    description?: string;
    jsonLd?: Record<string, unknown>;
    // Easter-egg pages: excluded from search indexing.
    noindex?: boolean;
    // Absolute URL of this page on the canonical deployment. The resume is
    // served from two origins (GitHub Pages and Cloudflare Pages) with
    // identical content, so without this a crawler sees two copies of the
    // site and picks a winner on its own. Omitted on pages that are noindex
    // or DEV-only - there is nothing to disambiguate.
    //
    // Doubles as the switch for everything else that describes the page to
    // the outside world: the language alternates and the link-preview tags.
    // A page that opts out of search has no business advertising itself to
    // either.
    canonical?: string;
}

const {
    lang,
    title,
    description,
    jsonLd,
    noindex = false,
    canonical,
} = Astro.props;

// Open Graph spells a locale language_TERRITORY, not the bare code used in
// <html lang> and hreflang.
const OG_LOCALE = { en: "en_US", ru: "ru_RU" } as const;

// debug-boxes - dev only: red outline on hover (see debug.css).
const isDev = import.meta.env.DEV;

// base ("/cv/" in prod, "/" otherwise) - prefix for static assets in public/.
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description ?? ""} />
        {canonical && (
            <>
                <link rel="canonical" href={canonical} />
                {/* Each language page names all of its siblings, itself
                     included, and the English root as the fallback. The
                     annotations only count when they are reciprocal, which
                     they are by construction: every page runs this same
                     loop over the same list. */}
                {LOCALES.map((l) => (
                    <link rel="alternate" hreflang={l} href={canonicalUrl(l)} />
                ))}
                <link
                    rel="alternate"
                    hreflang="x-default"
                    href={canonicalUrl("en")}
                />
                {/* Link preview: what a messenger or social network draws
                     when the address is pasted into a chat. */}
                <meta property="og:type" content="website" />
                <meta property="og:title" content={title} />
                <meta property="og:description" content={description ?? ""} />
                <meta property="og:url" content={canonical} />
                <meta property="og:locale" content={OG_LOCALE[lang]} />
                {LOCALES.filter((l) => l !== lang).map((l) => (
                    <meta
                        property="og:locale:alternate"
                        content={OG_LOCALE[l]}
                    />
                ))}
                <meta property="og:image" content={ogImageUrl(lang)} />
                <meta property="og:image:type" content="image/jpeg" />
                <meta
                    property="og:image:width"
                    content={String(OG_IMAGE.width)}
                />
                <meta
                    property="og:image:height"
                    content={String(OG_IMAGE.height)}
                />
                <meta property="og:image:alt" content={title} />
                <meta name="twitter:card" content="summary_large_image" />
            </>
        )}
        {noindex && <meta name="robots" content="noindex" />}
        {jsonLd && (
            <script
                is:inline
                type="application/ld+json"
                set:html={JSON.stringify(jsonLd)}
            ></script>
        )}
        {/* Applies the theme before first paint to avoid a flash of the light
             theme (FOUC). Without JS the fallback is :root (light). The toggle
             button and the localStorage write live in the Dock. */}
        <script is:inline>
            (function () {
                var saved = localStorage.getItem("theme");
                var prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                ).matches;
                var theme = saved || (prefersDark ? "dark" : "light");
                document.documentElement.setAttribute("data-theme", theme);
            })();
        </script>
        <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
        <link rel="icon" href={`${base}favicon.ico`} />
        <title>{title}</title>
    </head>
    <body class:list={[isDev && "debug-boxes"]}>
        <slot />
        <Dock lang={lang} />
        {/* Tooltips (data-tooltip) are dismissible via Escape: set a class on
             <html>, drop it on pointer move / focus change. CSS in styles.css. */}
        <script is:inline>
            (function () {
                var root = document.documentElement;
                document.addEventListener("keydown", function (e) {
                    if (e.key === "Escape")
                        root.classList.add("tooltips-dismissed");
                });
                ["pointermove", "focusin"].forEach(function (ev) {
                    document.addEventListener(ev, function () {
                        root.classList.remove("tooltips-dismissed");
                    });
                });
            })();
        </script>
    </body>
</html>
